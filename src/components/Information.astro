---
import { Image } from 'astro:assets';
import storeSignImage from '../assets/images/store-sign.jpeg';
import { siteContent } from '../content/siteContent';

const details = [
  { label: 'ADDRESS', value: siteContent.store.address },
  { label: 'STATION', value: siteContent.store.station },
  { label: 'HOURS / WEEKDAY', value: siteContent.store.weekdayHours },
  { label: 'HOURS / WEEKEND & HOLIDAY', value: siteContent.store.holidayHours },
  { label: 'CLOSED', value: siteContent.store.closed },
  { label: 'SEATS', value: siteContent.store.seats },
];
---

<section class="information" id="information" aria-labelledby="information-title">
  <div class="information__image-wrap" data-reveal>
    <Image
      class="information__image image-cover"
      src={storeSignImage}
      alt="Barなごみの営業時間と電話番号が記された店頭看板"
      widths={[640, 960, 1280]}
      sizes="(max-width: 899px) 100vw, 48vw"
      format="webp"
    />
  </div>

  <div class="information__content" data-reveal>
    <p class="section-kicker">{siteContent.information.eyebrow}</p>
    <h2 class="information__title" id="information-title">{siteContent.information.title}</h2>

    <dl class="information__list">
      {details.map((item) => (
        <div class="information__row">
          <dt class="information__term">{item.label}</dt>
          <dd class="information__definition">{item.value}</dd>
        </div>
      ))}
    </dl>

    <div class="information__actions">
      <a
        class="information__button information__button--gold link-reset"
        href={`tel:${siteContent.store.phoneHref}`}
        aria-label={`${siteContent.store.phone}へ電話する`}
      >
        <span class="information__button-label">TELEPHONE</span>
        <span class="information__button-value">{siteContent.store.phone}</span>
      </a>
      <a
        class="information__button link-reset"
        href={siteContent.store.mapUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="information__button-label">ACCESS</span>
        <span class="information__button-value">Google Maps</span>
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .information {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(460px, 1.05fr);
    min-height: 900px;
    background: var(--color-ink-soft);

    &__image-wrap {
      position: relative;
      min-height: 100%;
      overflow: hidden;
    }

    &__image {
      object-position: center;
      filter: saturate(0.72) contrast(1.03) brightness(0.82);
    }

    &__content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: var(--section-space) clamp(42px, 7vw, 120px);
      border-top: 1px solid var(--line);
    }

    &__title {
      margin: 0;
      font-size: clamp(2.6rem, 5vw, 5.3rem);
      font-weight: 400;
      letter-spacing: 0.05em;
      line-height: 1.3;
      white-space: nowrap;
    }

    &__list {
      display: grid;
      margin: clamp(48px, 6vw, 72px) 0 0;
    }

    &__row {
      display: grid;
      grid-template-columns: minmax(145px, 0.8fr) minmax(0, 1.2fr);
      gap: 28px;
      padding-block: 16px;
      border-bottom: 1px solid rgba(189, 163, 110, 0.22);
    }

    &__term,
    &__definition {
      margin: 0;
    }

    &__term {
      color: var(--color-gold);
      font-family: var(--font-en);
      font-size: 0.68rem;
      letter-spacing: 0.16em;
      line-height: 1.8;
    }

    &__definition {
      color: var(--color-paper);
      font-size: 0.88rem;
      letter-spacing: 0.05em;
      line-height: 1.8;
    }

    &__actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 42px;
    }

    &__button {
      display: grid;
      gap: 5px;
      padding: 17px 20px;
      border: 1px solid var(--line);
      transition: border-color 240ms ease, background 240ms ease;

      &:hover,
      &:focus-visible {
        border-color: var(--color-gold-bright);
        background: rgba(189, 163, 110, 0.08);
      }

      &--gold {
        border-color: rgba(189, 163, 110, 0.7);
      }
    }

    &__button-label {
      color: var(--color-gold);
      font-family: var(--font-en);
      font-size: 0.62rem;
      letter-spacing: 0.18em;
    }

    &__button-value {
      font-family: var(--font-en);
      font-size: clamp(1rem, 1.5vw, 1.22rem);
      letter-spacing: 0.05em;
      white-space: nowrap;
    }
  }

  @media (max-width: 899px) {
    .information {
      grid-template-columns: 1fr;
      min-height: 0;

      &__image-wrap {
        min-height: 62vh;
      }

      &__content {
        padding-inline: var(--side-space);
      }
    }
  }

  @media (max-width: 560px) {
    .information {
      &__image-wrap {
        min-height: 54vh;
      }

      &__title {
        font-size: clamp(2.45rem, 14vw, 3.8rem);
      }

      &__row {
        grid-template-columns: 1fr;
        gap: 5px;
        padding-block: 14px;
      }

      &__actions {
        grid-template-columns: 1fr;
      }

      &__button-value {
        font-size: 1.14rem;
      }
    }
  }
</style>
